# Environment for the macOS desktop build (vite --mode desktop).
# All runtime assets are served from the app bundle; nothing is fetched from CDNs.
# Fetch them first with: npm run desktop:assets
VITE_DESKTOP=true

VITE_WASM_PYMUPDF_URL=/desktop-assets/wasm/pymupdf/
VITE_WASM_GS_URL=/desktop-assets/wasm/gs/
VITE_WASM_CPDF_URL=/desktop-assets/wasm/cpdf/

VITE_TESSERACT_WORKER_URL=/desktop-assets/ocr/worker.min.js
VITE_TESSERACT_CORE_URL=/desktop-assets/ocr/core
VITE_TESSERACT_LANG_URL=/desktop-assets/ocr/lang-data
VITE_TESSERACT_AVAILABLE_LANGUAGES=eng,jpn,jpn_vert
VITE_OCR_FONT_BASE_URL=/desktop-assets/ocr/fonts

VITE_EMBEDPDF_FONTS_URL=/desktop-assets/fonts/embedpdf
