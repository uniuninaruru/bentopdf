{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BentoPDF",
  "version": "2.8.10",
  "identifier": "io.github.uniuninaruru.bentopdf",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://bentopdf-cors-proxy.bentopdf.workers.dev"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      },
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "BentoPDF contributors. Licensed under AGPL-3.0-only.",
    "shortDescription": "PDF viewer and editor",
    "longDescription": "A desktop build of BentoPDF: view, annotate, edit, organize, OCR, merge, split and compress PDFs offline.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "contentTypes": ["com.adobe.pdf"],
        "name": "PDF Document",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "gif",
          "webp",
          "bmp",
          "heic",
          "heif",
          "tif",
          "tiff",
          "avif"
        ],
        "contentTypes": [
          "public.jpeg",
          "public.png",
          "com.compuserve.gif",
          "org.webmproject.webp",
          "com.microsoft.bmp",
          "public.heic",
          "public.heif",
          "public.tiff",
          "public.avif"
        ],
        "name": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "doc",
          "docx",
          "xls",
          "xlsx",
          "ppt",
          "pptx",
          "odt",
          "ods",
          "odp",
          "rtf"
        ],
        "contentTypes": [
          "com.microsoft.word.doc",
          "org.openxmlformats.wordprocessingml.document",
          "com.microsoft.excel.xls",
          "org.openxmlformats.spreadsheetml.sheet",
          "com.microsoft.powerpoint.ppt",
          "org.openxmlformats.presentationml.presentation",
          "org.oasis-open.opendocument.text",
          "org.oasis-open.opendocument.spreadsheet",
          "org.oasis-open.opendocument.presentation",
          "public.rtf"
        ],
        "name": "Office Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
